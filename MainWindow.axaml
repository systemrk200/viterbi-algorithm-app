<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ViterbiAlgorithmApp.MainWindow"
        x:CompileBindings="False"
        Title="Алгоритм Витерби - сегментация" Width="800" Height="600">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="200"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="100"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" Text="1. Обучающий текст (со словами через пробелы):"/>
		<TextBox Grid.Row="1" Name="TrainingText" AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="Вставьте сюда текст с пробелами..."/>
		<Button Grid.Row="2" Content="Обучить" Click="OnTrainClick" Margin="0,5"/>
		<TextBlock Grid.Row="3" Name="StatusText" Foreground="Gray" Margin="0,0,0,10"/>

		<TextBlock Grid.Row="4" Text="2. Строка для разбиения (без пробелов):"/>
		<TextBox Grid.Row="5" Name="SegmentInput" AcceptsReturn="True" TextWrapping="Wrap"
                 PlaceholderText="например: мамамылараму"/>
		<Button Grid.Row="6" Content="Разбить" Click="OnSegmentClick" Margin="0,5"/>
		<TextBlock Grid.Row="7" Text="Результат:" Margin="0,10,0,0"/>
		<TextBlock Grid.Row="8" Name="SegmentResult" TextWrapping="Wrap" FontSize="16"/>
	</Grid>
</Window>